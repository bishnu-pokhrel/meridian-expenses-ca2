<%- include('layout') %>
<h1>Claim <%= c.id %></h1>
<p><b>Merchant:</b> <%= c.merchant %></p>
<p><b>Amount:</b> &euro;<%= c.amount %></p>
<p><b>Status:</b> <%= c.status %></p>
<p><b>Note:</b> <%= c.note %></p>
<p><a href="/receipt?f=claim-<%= c.id %>.txt">Receipt</a></p>
<% if (['finance','admin'].includes(user.role) && c.status === 'pending' && c.user_id !== user.uid) { %>
<form method="post" action="/claim/<%= c.id %>/approve"><button>Approve</button></form>
<% } %>
</body></html>
